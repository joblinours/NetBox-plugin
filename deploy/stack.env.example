# CMDB homelab — Portainer stack variables. KEEP SECRET: store in Vaultwarden, never commit.
# Generated by tools/generate-env.py

# --- Images
# latest (main), dev, a version (v1.2.3) or sha-<commit>
CMDB_IMAGE_TAG=latest
# netboxlabs/diode-* images
DIODE_VERSION=2.4.0

# --- Docker host / published ports
# LAN IP of the Docker host (LXC)
DOCKER_HOST_IP=192.168.1.13
# set to DOCKER_HOST_IP to listen on the LAN interface only
BIND_ADDRESS=0.0.0.0
# NetBox UI / API
NETBOX_PORT=8000
# Diode gRPC entry point (orb-agent, Nginx agent)
DIODE_GRPC_PORT=8081
TZ=Europe/Paris

# --- NetBox
# named admin account, created on first start only
NETBOX_ADMIN_USER=lucas
NETBOX_ADMIN_EMAIL=admin@example.com
NETBOX_ADMIN_PASSWORD=<generated by tools/generate-env.py>
NETBOX_SECRET_KEY=<generated by tools/generate-env.py>
# changing it invalidates every API token
NETBOX_API_TOKEN_PEPPER=<generated by tools/generate-env.py>
NETBOX_DB_PASSWORD=<generated by tools/generate-env.py>
NETBOX_REDIS_PASSWORD=<generated by tools/generate-env.py>
# space separated, e.g. 'cmdb.lan 192.168.1.13'
NETBOX_ALLOWED_HOSTS=*
# only needed behind an HTTPS reverse proxy
NETBOX_CSRF_TRUSTED_ORIGINS=

# --- Diode
DIODE_DB_PASSWORD=<generated by tools/generate-env.py>
DIODE_POSTGRES_ADMIN_PASSWORD=<generated by tools/generate-env.py>
DIODE_REDIS_PASSWORD=<generated by tools/generate-env.py>
HYDRA_DB_PASSWORD=<generated by tools/generate-env.py>
# Hydra system secret
HYDRA_SECRETS_SYSTEM=<generated by tools/generate-env.py>
# OAuth2 client diode-to-netbox
DIODE_CLIENT_SECRET_DIODE_TO_NETBOX=<generated by tools/generate-env.py>
# OAuth2 client netbox-to-diode
DIODE_CLIENT_SECRET_NETBOX_TO_DIODE=<generated by tools/generate-env.py>
# OAuth2 client orb-agent (network scan)
DIODE_CLIENT_SECRET_ORB_AGENT=<generated by tools/generate-env.py>
# OAuth2 client nginx-agent (copy into the agent's env file)
DIODE_CLIENT_SECRET_NGINX_AGENT=<generated by tools/generate-env.py>

# --- API tokens, one per consumer (NetBox v2 format)
# orb-agent -> scan status
CMDB_TOKEN_ORB_AGENT=<generated by tools/generate-env.py>
# Nginx agent -> run status (copy into the agent's env file)
CMDB_TOKEN_NGINX_AGENT=<generated by tools/generate-env.py>
# Zabbix -> {$CMDB.TOKEN} macro
CMDB_TOKEN_ZABBIX=<generated by tools/generate-env.py>
# Docker agents (this stack and other Docker hosts)
CMDB_TOKEN_DOCKER_AGENT=<generated by tools/generate-env.py>
# Claude Code MCP server (read-only)
CMDB_TOKEN_MCP=<generated by tools/generate-env.py>

# --- Proxmox (read-only API token, role PVEAuditor)
# IP or DNS name of any cluster node
PROXMOX_HOST=
PROXMOX_PORT=8006
PROXMOX_USER=netbox@pve
PROXMOX_TOKEN_NAME=cmdb
# token secret (UUID) shown once by Proxmox
PROXMOX_TOKEN_VALUE=
# true once Proxmox has a trusted certificate
PROXMOX_VERIFY_SSL=false
# minutes
PROXMOX_SYNC_INTERVAL=1440

# --- Cloudflare Tunnel (read-only token: Account > Cloudflare Tunnel > Read)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# optional, comma separated; empty = all tunnels
CLOUDFLARE_TUNNEL_IDS=
# minutes
CLOUDFLARE_SYNC_INTERVAL=1440
# IP(s) of revers-proxy, comma separated: origin = this host -> 'via Nginx'
NGINX_PROXY_HOSTS=

# --- Network scan (orb-agent)
# comma separated
SCAN_TARGETS=192.168.1.0/24
# cron, daily at 03:00
SCAN_SCHEDULE=0 3 * * *
SCAN_TOP_PORTS=1000
SCAN_TIMEOUT_MINUTES=120
# also scan once when the container starts
SCAN_STARTUP=true

# --- AdGuard Home (DNS rewrites)
# comma separated, e.g. http://192.168.1.2:3000
ADGUARD_URLS=
ADGUARD_USERNAME=
ADGUARD_PASSWORD=
ADGUARD_VERIFY_SSL=true
# minutes
ADGUARD_SYNC_INTERVAL=1440
# also write A/CNAME records into netbox-plugin-dns
ADGUARD_SYNC_NETBOX_DNS=true
ADGUARD_AUTO_CREATE_ZONES=true

# --- Docker inventory
# name of the Docker host (LXC) in NetBox
DOCKER_AGENT_HOST_NAME=docker
# every Docker host with an agent, comma separated (default: DOCKER_AGENT_HOST_NAME)
DOCKER_AGENT_HOSTS=
# seconds
DOCKER_AGENT_INTERVAL=3600

# --- MCP server (Claude Code)
MCP_DEFAULT_PREFIX=192.168.1.0/24
# never proposed as free, e.g. 192.168.1.100-192.168.1.199 (DHCP)
MCP_RESERVED_IP_RANGES=

# --- Health
# a source not successful for longer is reported to Zabbix
SOURCE_MAX_AGE_HOURS=26
