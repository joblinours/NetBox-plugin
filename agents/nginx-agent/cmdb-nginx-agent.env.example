# /etc/cmdb-nginx-agent.env  (chmod 600) — values from the stack variables / Vaultwarden
DIODE_TARGET=grpc://192.168.1.13:10001/diode
DIODE_CLIENT_ID=nginx-agent
DIODE_CLIENT_SECRET=<DIODE_CLIENT_SECRET_NGINX_AGENT>
# Name of this machine in NetBox (as imported by the Proxmox plugin) and its cluster
NGINX_AGENT_HOST_NAME=revers-proxy
NGINX_AGENT_HOST_TYPE=vm
# Cluster, cluster type and site are read from NetBox with NETBOX_TOKEN; set them only to override
#NGINX_AGENT_CLUSTER=homelab
#NGINX_AGENT_CLUSTER_TYPE=Proxmox Cluster
#NGINX_AGENT_CLUSTER_SITE=Proxmox2NetBox
# Run status, for Zabbix
NETBOX_URL=http://192.168.1.13:10000
NETBOX_TOKEN=<CMDB_TOKEN_NGINX_AGENT>
